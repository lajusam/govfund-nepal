{
  "name": "govfund-nepal-remotion",
  "version": "1.0.0",
  "description": "Cinematic product demo video for GovFund Nepal",
  "scripts": {
    "start": "npx remotion studio",
    "build": "npx remotion render GovFundNepal out/govfund-nepal.mp4",
    "preview": "npx remotion studio",
    "render": "npx remotion render GovFundNepal out/govfund-nepal.mp4 --codec=h264",
    "render-webm": "npx remotion render GovFundNepal out/govfund-nepal.webm --codec=vp8"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.190",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.190"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.5.4"
  }
}
